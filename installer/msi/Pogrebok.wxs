<?xml version="1.0" encoding="UTF-8"?>
<!--
  Погребок — MSI (WiX v4/v5, спека §11: полная установка, один UAC).

  Состав: ProgramFiles\Pogrebok\{pogrebok.exe, pogrebok-daemon.exe,
  pogrebok-svc.exe, pogrebok-gui.exe, appliance\pogrebok-rootfs.tar.gz};
  PATH (machine); служба маршрутов — нашим `pogrebok-svc` с аргументом
  install (custom action после InstallFiles, uninstall-зеркало перед
  RemoveFiles); компоненты WSL — `wsl` с аргументами install
  no-distribution (код 3010 «нужна перезагрузка»
  переводится обёрткой в успех; перезагрузку НЕ назначаем принудительно —
  doctor и README объясняют). Major upgrade: UpgradeCode фиксирован,
  даунгрейд отвергается. Версия приходит переменной -d ProductVersion=
  (единственный источник — [workspace.package].version, рулинг M3).

  Сборка: installer/msi/build-msi.ps1 (переменные BuildDir/RootfsPath/
  ProductVersion передаются ключами -d).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Погребок"
      Language="1049"
      Codepage="1251"
      Version="$(ProductVersion)"
      Manufacturer="Погребок"
      UpgradeCode="8F0A3B62-4C1D-4E9A-9B7D-2E5F1A6C0D83"
      Scope="perMachine"
      InstallerVersion="500">

    <SummaryInformation Description="Погребок — одновременные изолированные VPN-окружения" />

    <!-- Major upgrade: даунгрейд отвергается (Review Focus M3 #3);
         старая версия сносится до установки новой (служба успевает
         сняться её же uninstall-действием). -->
    <MajorUpgrade DowngradeErrorMessage="Более новая версия Погребка уже установлена: сначала удалите её (Панель управления - Приложения)." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="Installed OR VersionNT64" Message="Погребок требует 64-разрядную Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Pogrebok">
        <Directory Id="ApplianceDir" Name="appliance" />
      </Directory>
    </StandardDirectory>

    <!-- Ярлык GUI в меню Пуск (M4): рядом с бинарниками INSTALLDIR —
         GUI резолвит pogrebok/pogrebok-daemon относительно своего exe (D5). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="GuiStartMenuShortcut" Guid="F6B08C7D-2E95-4A0D-8176-A93D45E6F089">
        <Shortcut Id="PogrebokGuiShortcut"
            Name="Погребок"
            Description="Погребок — управление бутылками"
            Target="[INSTALLDIR]pogrebok-gui.exe"
            WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKLM" Key="Software\Pogrebok"
            Name="GuiShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Level="1" Title="Погребок" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
      <!-- Ярлык меню Пуск — отдельный компонент вне ProductComponents
           (живёт в ProgramMenuFolder): без ComponentRef он «orphaned»
           и wix build падает (finding C1 финального ревью M4). -->
      <ComponentRef Id="GuiStartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="pogrebok_exe" Guid="A1C53D2E-7F40-4B8A-9C21-5D6E8F0B1A34">
        <File Id="pogrebok.exe" Source="$(BuildDir)pogrebok.exe" KeyPath="yes" />
      </Component>
      <Component Id="pogrebok_daemon_exe" Guid="B2D64E3F-8A51-4C9B-AD32-6E7FA01C2B45">
        <File Id="pogrebok_daemon.exe" Source="$(BuildDir)pogrebok-daemon.exe" Name="pogrebok-daemon.exe" KeyPath="yes" />
      </Component>
      <Component Id="pogrebok_svc_exe" Guid="C3E75F4A-9B62-4DAC-BE43-7F80B12D3C56">
        <File Id="pogrebok_svc.exe" Source="$(BuildDir)pogrebok-svc.exe" Name="pogrebok-svc.exe" KeyPath="yes" />
      </Component>
      <Component Id="pogrebok_gui_exe" Guid="A7B19D8E-5F06-4C1B-9265-B04E67A81F90">
        <File Id="pogrebok_gui.exe" Source="$(GuiExePath)" Name="pogrebok-gui.exe" KeyPath="yes" />
      </Component>
      <Component Id="rootfs_tar" Directory="ApplianceDir" Guid="D4F86A5B-0C73-4EBD-AF54-8A91C23E4D67">
        <File Id="rootfs.tar.gz" Source="$(RootfsPath)" Name="pogrebok-rootfs.tar.gz" KeyPath="yes" />
      </Component>
      <!-- PATH (machine): pogrebok/pogrebok-daemon доступны из любого
           терминала. Ключ реестра — KeyPath компонента (Environment
           нельзя). -->
      <Component Id="PathEnv" Guid="E5A97B6C-1D84-4FCE-B065-9BA2D34F5E78">
        <Environment Id="PogrebokPath"
            Name="PATH"
            Value="[INSTALLDIR]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
        <RegistryValue Root="HKLM" Key="Software\Pogrebok"
            Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Служба маршрутов: наш `install`-аргумент (русское описание,
         автозапуск, SYSTEM). Ограничение (рулинг): поверх ручной
         установки службы MSI откажет с внятным текстом
         ERROR_SERVICE_EXISTS — снимите службу вручную (pogrebok-svc
         с аргументом uninstall) перед MSI. -->
    <CustomAction Id="InstallSvc"
        FileRef="pogrebok_svc.exe"
        ExeCommand="--install"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction Id="UninstallSvc"
        FileRef="pogrebok_svc.exe"
        ExeCommand="--uninstall"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <!-- WSL: включение компонентов без дистрибутива. Обёртка на
         PowerShell переводит 3010 («нужна перезагрузка») в 0 —
         принудительную перезагрузку не назначаем (см. шапку).
         powershell.exe ищется по PATH (System32\WindowsPowerShell\v1.0
         входит в machine PATH по умолчанию): deferred-CA не может
         сослаться на [System64Folder], а Script="PowerShell" в WiX
         не существует (finding локальной сборки 2026-10). -->
    <CustomAction Id="EnableWsl"
        Directory="System64Folder"
        ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $p = Start-Process wsl.exe -ArgumentList '--install','--no-distribution' -WindowStyle Hidden -Wait -PassThru; if ($p.ExitCode -eq 3010) { exit 0 } else { exit $p.ExitCode } }&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <!-- Rollback-зеркало InstallSvc (finding 3 финального ревью):
         отказ ПОСЛЕ установки службы (например, EnableWsl на
         залоченной политикой машине) не должен оставлять службу,
         ссылающуюся на откатанные файлы. -->
    <CustomAction Id="RollbackSvc"
        FileRef="pogrebok_svc.exe"
        ExeCommand="--uninstall"
        Execute="rollback"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <!-- Порядок: сначала WSL (может отказать — служба ещё не
           поставлена, откатывать нечего), затем служба; rollback
           службы заряжается перед её установкой. Условие NOT
           Installed: repair НЕ дергает установку службы поверх
           живой (файлы ремонта восстанавливаются, служба уже есть). -->
      <Custom Action="EnableWsl" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RollbackSvc" Before="InstallSvc" />
      <Custom Action="InstallSvc" After="EnableWsl" Condition="NOT Installed" />
      <Custom Action="UninstallSvc" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
